# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO PARA COMPILACIÓN Y EJECUCIÓN (BUILD / RUN)
# ==============================================================================

# Intervalo en segundos para la sincronización automática periódica en segundo plano
VITE_SYNC_INTERVAL_SEC=30

# Modo de entorno por defecto ('tauri' | 'web' | 'mock')
VITE_APP_ENV=tauri

# Puerto TCP por defecto para caudalímetros ESP32
VITE_DEFAULT_ESP32_PORT=3333

# Configuración opcional para almacenamiento y sincronización en Supabase Cloud (SPA Web)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
